line      (0,0)-(0,0) p90   MdviewH1Bg         ""
replace   (0,0)-(0,2) p100  MdviewH1           "◈ "
line      (2,0)-(2,0) p90   MdviewH2Bg         ""
replace   (2,0)-(2,3) p100  MdviewH2           "◆ "
line      (4,0)-(4,0) p90   MdviewH3Bg         ""
replace   (4,0)-(4,4) p100  MdviewH3           "▸ "
conceal   (4,30)-(4,34) p100  -                  ""
replace   (6,0)-(6,2) p100  MdviewBullet       "● "
conceal   (7,0)-(7,2) p100  -                  ""
replace   (7,2)-(7,6) p100  MdviewUnchecked    "󰄱 "
replace   (8,2)-(8,4) p100  MdviewBullet       "○ "
replace   (10,0)-(10,2) p100  MdviewQuote        "▎ "
replace   (11,0)-(11,2) p100  MdviewQuote        "▎ "
